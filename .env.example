# Copia este archivo como .env para pruebas locales con `netlify dev`.
# En producción NO se sube: estas variables se cargan en Netlify
# (Site configuration -> Environment variables).

# 1) Respuesta de la primera pregunta ("¿Cuál es el color favorito de Luis?")
#    Varias respuestas válidas separadas por coma. No distingue mayúsculas ni tildes.
GATE_ANSWER=Azul

# 2) Contraseña del Panel Admin
ADMIN_PASSWORD=234250

# 3) ID de tu Google Sheet (lo que va entre /d/ y /edit en la URL)
GOOGLE_SHEET_ID=1nIHjhlXMCZ8cn4I1roC3oudF7N_JJ6X62FO_N1cmVdA

# 4) Clave para firmar las sesiones (cadena aleatoria larga, mínimo 32 caracteres)
SESSION_SECRET=paguememiplata2818

# 5) Fecha de inicio del cronómetro (AAAA-MM-DD)
START_DATE=206-05-08
